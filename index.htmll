      <div class="card">
        <h3>📱 Digital Skills</h3>
        <p>Exploring digital platforms and online tools.</p>
      </div>

    </div>
  </section>


  <!-- PROJECTS -->
  <section id="projects">
    <h2>My Projects</h2>

    <div class="cards">

      <div class="card">
        <h3>🌐 Personal Website</h3>
        <p>
          My personal website created using HTML and CSS
          and published online.
        </p>
      </div>

      <div class="card">
        <h3>💡 Future Projects</h3>
        <p>
          More projects will be added here in the future.
        </p>
      </div>

    </div>
  </section>


  <!-- GALLERY -->
  <section id="gallery">
    <h2>My Gallery</h2>

    <div class="gallery">

      <!-- अपनी photos की link यहाँ डालना -->
