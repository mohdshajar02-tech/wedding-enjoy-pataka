    <div>
      <h1>Hello, I'm <span>Mohd Shajar</span></h1>

      <p>
        Welcome to my personal website
      </p>

      <p>
        📍 Meerut, Uttar Pradesh, India
      </p>

      <br>

      <a class="btn" href="#about">About Me</a>
      <a class="btn" href="#contact">Contact Me</a>
    </div>
  </section>


