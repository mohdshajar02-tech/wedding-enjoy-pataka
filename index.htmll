<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Mohd Shajar | Personal Website</title>

  <meta name="description"
        content="Official personal website of Mohd Shajar from Meerut, Uttar Pradesh.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0b0f19;
      color: white;
      line-height: 1.6;
    }

    nav {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(11,15,25,0.95);
      padding: 15px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #222;
    }

    nav h2 {
      color: #00d9ff;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 15px;
      font-size: 14px;
    }

    nav a:hover {
      color: #00d9ff;
    }

    .hero {
      min-height: 90vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 30px;
      background: linear-gradient(135deg, #0b0f19, #111b35);
    }

    .hero h1 {
      font-size: 48px;
      margin-bottom: 15px;
    }

    .hero h1 span {
      color: #00d9ff;
    }

    .hero p {
      color: #c8c8c8;
      font-size: 18px;
      margin-bottom: 25px;
    }

    .btn {
      display: inline-block;
      padding: 12px 22px;
      margin: 5px;
      border-radius: 25px;
      background: #00d9ff;
      color: #001018;
      text-decoration: none;
      font-weight: bold;
    }

    .btn:hover {
      transform: scale(1.05);
    }

    section {
      padding: 70px 8%;
      text-align: center;
    }

    section h2 {
      font-size: 32px;
      margin-bottom: 30px;
      color: #00d9ff;
    }

    .about {
      max-width: 800px;
      margin: auto;
      color: #ddd;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }

    .card {
      background: #151b2b;
      padding: 25px;
      border-radius: 15px;
      border: 1px solid #252d42;
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-7px);
      border-color: #00d9ff;
    }

    .card h3 {
      color: #00d9ff;
      margin-bottom: 10px;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 15px;
    }

    .gallery img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 12px;
      border: 2px solid #252d42;
    }

    .contact-box {
      max-width: 600px;
      margin: auto;
      background: #151b2b;
      padding: 30px;
      border-radius: 15px;
    }

    .contact-box p {
      margin: 10px 0;
    }

    footer {
      text-align: center;
      padding: 25px;
      background: #070a11;
      color: #aaa;
    }

    @media (max-width: 600px) {
      nav {
        flex-direction: column;
        gap: 10px;
      }

      nav a {
        margin: 5px;
      }

      .hero h1 {
        font-size: 35px;
      }

      section {
        padding: 55px 5%;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->
  <nav>
    <h2>Mohd Shajar</h2>

